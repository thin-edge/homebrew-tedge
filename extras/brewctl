#!/bin/sh
set -e

help() {
    cat << EOT >&2
thin-edge.io adapter to homebrew to control services

SUBCOMMANDS
    reboot
    services <start|restart|stop|is_available|enable|disable|is_active> <SERVICE_NAME>

EXAMPLES
    $0 reboot
    # Trigger a fake reboot

    $0 services start tedge-agent
    # Start tedge-agent

    $0 services stop tedge-agent
    # Stop tedge-agent

    $0 services restart tedge-agent
    # Restart tedge-agent

    $0 services restart tedge
    # Restart the all-in-one tedge service (tedge run all), provided by the linked tedge/tedge-main formula
EOT
}

if [ $# -lt 1 ]; then
    help
    exit 1
fi

command_exists() {
    command -V "$1" >/dev/null 2>&1
}


# 
# Find brew path
#
BREW="${BREW:-brew}"

# Use full path to brew
if ! command_exists "$BREW"; then
    if [ -f /opt/homebrew/bin/brew ]; then
        BREW="/opt/homebrew/bin/brew"
    elif [ -f /usr/local/bin/brew ]; then
        BREW="/usr/local/bin/brew"
    elif [ -f /home/linuxbrew/.linuxbrew/bin/brew ]; then
        BREW="/home/linuxbrew/.linuxbrew/bin/brew"
    fi
fi

COMMAND="$1"
shift

# Map a service name to the formula which provides it, as brew services only accepts formula names.
# The all-in-one "tedge" service (tedge run all) is provided by whichever tedge formula is
# currently linked, e.g. tedge-main
service_formula() {
    case "$1" in
        tedge)
            TARGET=$(readlink "$("$BREW" --prefix)/bin/tedge" 2>/dev/null || true)
            case "$TARGET" in
                */Cellar/*) echo "$TARGET" | sed 's|.*/Cellar/\([^/]*\)/.*|\1|' ;;
                *) echo "$1" ;;
            esac
            ;;
        *)
            echo "$1"
            ;;
    esac
}

service_mgmt() {
    SUBCOMMAND="$1"
    shift
    NAME=

    if [ $# -gt 0 ]; then
        NAME="$1"
        shift
    fi

    fail_if_empty() {
        if [ -z "$1" ]; then
            echo "Service name is empty" >&2
            exit 1
        fi
    }

    case "$SUBCOMMAND" in
        is_available)
            "$BREW" services --help >/dev/null 2>&1
            ;;
        is_active|is-active)
            fail_if_empty "$NAME"
            "$BREW" services info "$(service_formula "$NAME")" | grep -q "PID:"
            ;;
        restart)
            fail_if_empty "$NAME"
            "$BREW" services restart "$(service_formula "$NAME")"
            ;;
        start)
            fail_if_empty "$NAME"
            "$BREW" services start "$(service_formula "$NAME")"
            ;;
        stop)
            fail_if_empty "$NAME"
            "$BREW" services stop "$(service_formula "$NAME")"
            ;;
        enable|disable)
            # no-op
            exit 0
            ;;
        *)
            echo "Unknown command: '$SUBCOMMAND'" >&2
            exit 1
            ;;
    esac
}


case "$COMMAND" in 
    services)
        service_mgmt "$@"
        ;;
    
    reboot)
        echo "simulating a restart"
        exit 0
        ;;
    *)
        echo "Unknown command: '$COMMAND'" >&2
        exit 1
        ;;

esac

exit 0
